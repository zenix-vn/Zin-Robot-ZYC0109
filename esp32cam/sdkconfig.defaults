# ESP32-CAM (AI-Thinker): 4 MB flash, 4 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_HZ=1000
# BTstack runs in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# motors starting can dip the supply
CONFIG_ESP_BROWNOUT_DET=n

# UART0 belongs to the STM32 link (9600 baud): no console, no boot chatter on it
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# Bluetooth: controller only, BTstack is the host. Classic BR/EDR for the DualSense.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
# at least one more than CONFIG_BLUEPAD32_MAX_DEVICES
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=3
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BTSTACK_AUDIO=n

# Bluepad32
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=2
CONFIG_BLUEPAD32_ENABLE_BLE_BY_DEFAULT=n
CONFIG_BLUEPAD32_ENABLE_VIRTUAL_DEVICE_BY_DEFAULT=n

# Wi-Fi + Bluetooth + camera do not fit IRAM with the speed-ups on
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# chip is ESP32-D0WD-V3: no PSRAM cache workaround needed, more of libc runs from ROM
CONFIG_ESP32_REV_MIN_3=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
